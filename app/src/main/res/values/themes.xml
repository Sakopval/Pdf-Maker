        <item name="materialSearchBarStyle">@style/Widget.Material3.SearchBar.PdfMaker</item>
        <item name="toolbarStyle">@style/Widget.Material3.SearchView.Toolbar.PdfMaker</item>
        <item name="rippleColor">@android:color/darker_gray</item>

        <item name="colorPrimary">@color/btn_col</item>
        <item name="colorOnPrimary">@color/md_dark_on_primary</item>
        <item name="colorPrimaryContainer">@color/md_dark_primary_container</item>
