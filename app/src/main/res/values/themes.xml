<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Material3.Dark.NoActionBar.PdfMaker" parent="Theme.Material3.Dark.NoActionBar">
        <item name="android:fitsSystemWindows">false</item>
        <item name="android:background">@color/bkg</item>
        <item name="fontFamily">@font/arlrdbd</item>
        <item name="android:textColor">@color/txt</item>
        <item name="materialButtonStyle">@style/Widget.Material3.Button.PdfMaker</item>
