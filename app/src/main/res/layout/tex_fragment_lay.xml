<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:theme="@style/Theme.Material3.Dark.NoActionBar.PdfMaker">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:id="@+id/no_doc_lay_tex"
        android:visibility="gone">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="@string/no_docs_msg"
            android:id="@+id/no_docs_msg"/>
        <com.google.android.material.button.MaterialButton
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/make_one_txt"
            android:layout_centerHorizontal="true"
            android:id="@+id/make_doc_but"
            android:layout_below="@+id/no_docs_msg"
            android:layout_marginTop="10dp"/>
    </RelativeLayout>
        <androidx.recyclerview.widget.RecyclerView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:id="@+id/tex_list"
            android:visibility="gone"/>
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_centerInParent="true"
        android:background="#77000000"
        android:fitsSystemWindows="true"
        android:id="@+id/loading_lay"
        android:visibility="visible">
        <com.google.android.material.loadingindicator.LoadingIndicator
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:fitsSystemWindows="true"
            android:backgroundTint="@android:color/transparent"
            android:id="@+id/loading"
            android:visibility="visible"
            />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/loading"
            android:layout_below="@id/loading"
            android:background="@android:color/transparent"
            android:layout_centerHorizontal="true"
            android:id="@+id/state_text"
            android:visibility="visible"
            />
    </RelativeLayout>


</RelativeLayout>