<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:theme="@style/Theme.Material3.Dark.NoActionBar.PdfMaker"
    tools:context=".AllWorkSpacesActivity"
    tools:viewBindingIgnore="false"
    android:id="@+id/workspaces_activity">

    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:backgroundTint="@android:color/transparent">
        <com.google.android.material.appbar.AppBarLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fitsSystemWindows="true"
            android:theme="@style/Widget.Material3.AppBarLayout.PdfMaker"
            android:id="@+id/appBarLay">
                <com.google.android.material.appbar.MaterialToolbar
                    android:layout_width="match_parent"
                    android:layout_height="?attr/actionBarSize"
                    app:title="@string/work_spaces"
                    android:id="@+id/toolBar"
                    />
        </com.google.android.material.appbar.AppBarLayout>
        <androidx.recyclerview.widget.RecyclerView
            android:nestedScrollingEnabled="true"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_behavior="com.google.android.material.appbar.AppBarLayout$ScrollingViewBehavior"
            android:id="@+id/workspaces"
            android:layout_marginTop="4dp"
            android:visibility="gone"
            tools:listitem="@layout/workspace_item"
            />
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@android:color/transparent"
            android:id="@+id/no_wsp_lay"
            android:visibility="gone">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:text="@string/you_don_t_have_any_workspaces_yet"
                android:id="@+id/no_workspaces_msg"/>
            <com.google.android.material.button.MaterialButton
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@id/no_workspaces_msg"
                android:layout_centerHorizontal="true"
                android:text="@string/make_one_txt"/>
        </RelativeLayout>
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_centerInParent="true"
            android:background="@color/loading_bkg"
            android:id="@+id/loading_lay"
            android:visibility="visible">
            <com.google.android.material.loadingindicator.LoadingIndicator
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:fitsSystemWindows="true"
                android:backgroundTint="@android:color/transparent"
                android:id="@+id/loading"
                android:visibility="visible"
                />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/loading"
                android:layout_below="@id/loading"
                android:layout_centerHorizontal="true"
                android:id="@+id/state_text"
                android:visibility="visible"
                />
        </RelativeLayout>
    </androidx.coordinatorlayout.widget.CoordinatorLayout>

</RelativeLayout>