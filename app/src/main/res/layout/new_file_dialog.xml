<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:viewBindingIgnore="false"
    android:padding="20dp"
    android:orientation="vertical">
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:id="@+id/title"
        android:layout_marginBottom="10dp"
        android:layout_marginTop="25dp"
        android:layout_marginEnd="25dp"
        android:textColor="@color/txt"
        android:text="@string/new_file"
        style="@style/TextAppearance.Material3.HeadlineLarge"/>
    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/new_file"
        app:suffixText=".tex"
        android:layout_margin="10dp"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox.Dense"
        android:id="@+id/input_lay">
        <com.google.android.material.textfield.TextInputEditText
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/Widget.Material3.TextInputEditText.OutlinedBox.Dense"
            android:id="@+id/edit_text"/>
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        android:layout_margin="10dp"
        android:hint="@string/work_spaces"
        android:id="@+id/ws_chooser"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox.Dense.ExposedDropdownMenu">
        <AutoCompleteTextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="none"
            android:id="@+id/autoComplete"
            />
    </com.google.android.material.textfield.TextInputLayout>
    <CheckBox
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:id="@+id/new_ws"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="10dp"
        android:layout_marginBottom="10dp"
        android:text="@string/new_workspace"
        android:layout_marginStart="10dp"/>

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/new_workspace_name"
        android:layout_margin="10dp"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox.Dense"
        android:id="@+id/input_lay2"
        android:visibility="gone">
        <com.google.android.material.textfield.TextInputEditText
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/Widget.Material3.TextInputEditText.OutlinedBox.Dense"
            android:id="@+id/edit_text2"/>
    </com.google.android.material.textfield.TextInputLayout>

   <RelativeLayout
       android:layout_width="match_parent"
       android:layout_height="wrap_content">
       <LinearLayout
           android:layout_width="wrap_content"
           android:layout_height="wrap_content"
           android:orientation="horizontal"
           android:layout_alignParentEnd="true">
           <com.google.android.material.button.MaterialButton
               android:layout_width="wrap_content"
               android:layout_height="wrap_content"
               style="@style/Widget.Material3.Button.OutlinedButton"
               android:text="@string/cancel"
               android:layout_marginTop="20dp"
               android:layout_marginEnd="10dp"
               android:layout_marginBottom="20dp"
               app:rippleColor="@android:color/darker_gray"
               android:id="@+id/cancel"/>

           <com.google.android.material.button.MaterialButton
               android:layout_width="wrap_content"
               android:layout_height="wrap_content"
               android:text="@string/ok"
               android:layout_marginTop="20dp"
               android:layout_marginStart="10dp"
               android:layout_marginBottom="20dp"
               android:layout_marginEnd="10dp"
               style="@style/Widget.Material3.Button.OutlinedButton"
               app:rippleColor="@android:color/darker_gray"
               android:id="@+id/ok"/>
       </LinearLayout>
   </RelativeLayout>
</LinearLayout>