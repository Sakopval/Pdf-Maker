<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:theme="@style/Theme.Material3.Dark.NoActionBar.PdfMaker"
    tools:context=".FontsActivity"
    tools:viewBindingIgnore="false"
    android:id="@+id/font_activity"
    android:background="@color/bkg">

    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:backgroundTint="@android:color/transparent">
        <com.google.android.material.appbar.AppBarLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fitsSystemWindows="true"
            android:theme="@style/Widget.Material3.AppBarLayout.PdfMaker"
            android:id="@+id/appBarLay">
            <com.google.android.material.appbar.MaterialToolbar
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                app:title="Fonts"
                android:id="@+id/toolBar"
                />
            <com.google.android.material.search.SearchBar
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:id="@+id/srch_bar"
                app:layout_scrollEffect="none"
                app:liftOnScrollColor="@color/srch_bkg"
                app:liftOnScroll="true"
                android:visibility="visible" />
        </com.google.android.material.appbar.AppBarLayout>
        <com.google.android.material.search.SearchView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:id="@+id/srch_view"
            android:fitsSystemWindows="true"
            android:hint="@string/search"
            app:layout_behavior="com.google.android.material.search.SearchView$Behavior"
            app:layout_anchor="@id/srch_bar"
            android:theme="@style/ThemeOverlay.Material3Expressive.SearchView.AppBarWithSearch.PdfMaker"
            android:visibility="visible">
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:id="@+id/no_matches"
                    android:text="@string/no_matches_found"
                    android:background="@android:color/transparent"
                    android:layout_centerInParent="true"
                    android:visibility="gone"/>
                <androidx.recyclerview.widget.RecyclerView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:nestedScrollingEnabled="true"
                    android:id="@+id/matches_list"
                    android:visibility="visible"/>
            </RelativeLayout>
        </com.google.android.material.search.SearchView>
        <androidx.recyclerview.widget.RecyclerView
            android:nestedScrollingEnabled="true"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_behavior="com.google.android.material.appbar.AppBarLayout$ScrollingViewBehavior"
            android:id="@+id/fonts_recycler"
            android:layout_marginTop="4dp"
            android:visibility="gone"
            tools:listitem="@layout/result_item"
            />
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@android:color/transparent"
            android:id="@+id/no_fonts_lay"
            android:visibility="gone">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:text="@string/you_don_t_have_any_fonts"
                android:id="@+id/no_fonts_msg"/>
        </RelativeLayout>
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_centerInParent="true"
            android:background="@color/loading_bkg"
            android:id="@+id/loading_lay"
            android:visibility="visible">
            <com.google.android.material.loadingindicator.LoadingIndicator
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:fitsSystemWindows="true"
                android:backgroundTint="@android:color/transparent"
                android:id="@+id/loading"
                android:visibility="visible"
                />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/loading"
                android:layout_below="@id/loading"
                android:layout_centerHorizontal="true"
                android:id="@+id/state_text"
                android:visibility="visible"
                />
        </RelativeLayout>
    </androidx.coordinatorlayout.widget.CoordinatorLayout>

</RelativeLayout>