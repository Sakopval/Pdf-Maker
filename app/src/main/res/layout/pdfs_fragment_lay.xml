<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:tools="http://schemas.android.com/tools"
    android:theme="@style/Theme.Material3.Dark.NoActionBar.PdfMaker"
    android:background="@color/bkg">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:id="@+id/no_doc_lay"
        android:visibility="gone">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="@string/no_docs_msg"
            android:id="@+id/no_docs_msg"/>
    </RelativeLayout>
    <androidx.recyclerview.widget.RecyclerView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:id="@+id/pdfs_list"
        tools:itemCount="50"
        tools:listitem="@layout/pdf_item"
        android:visibility="gone"
        android:nestedScrollingEnabled="true"/>
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_centerInParent="true"
        android:background="@color/loading_bkg"
        android:fitsSystemWindows="true"
        android:id="@+id/loading_lay"
        android:visibility="visible">
        <com.google.android.material.loadingindicator.LoadingIndicator
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:fitsSystemWindows="true"
            android:backgroundTint="@android:color/transparent"
            android:id="@+id/loading"
            android:visibility="visible"
            />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/loading"
            android:layout_below="@id/loading"
            android:layout_centerHorizontal="true"
            android:id="@+id/state_text"
            android:visibility="visible"
            />
    </RelativeLayout>

</RelativeLayout>