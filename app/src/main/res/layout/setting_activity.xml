<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:theme="@style/Theme.Material3.Dark.NoActionBar.PdfMaker"
    android:id="@+id/settingsActivity"
    tools:context=".SettingsActivity"
    android:background="@color/bkg">
    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:id="@+id/coordinator">
        <com.google.android.material.appbar.AppBarLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fitsSystemWindows="true"
            app:liftOnScroll="false"
            android:id="@+id/appBarLay"
            android:theme="@style/Widget.Material3.AppBarLayout.PdfMaker"
            app:layout_behavior="com.google.android.material.appbar.AppBarLayout$ScrollingViewBehavior">
            <com.google.android.material.appbar.MaterialToolbar
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                android:id="@+id/toolbar"
                app:layout_scrollEffect="none"
                app:title="Settings"/>
        </com.google.android.material.appbar.AppBarLayout>
        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_behavior="com.google.android.material.appbar.AppBarLayout$ScrollingViewBehavior"
            android:id="@+id/nested_scroll"
            android:layout_marginTop="5dp">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">


                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:id="@+id/settings">
                    <!--                latex settings-->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/latex"
                        android:textColor="@color/ex_item"
                        android:layout_marginStart="18dp"/>
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_margin="8dp"
                        android:backgroundTint="#343434">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:background="@android:color/transparent">
                            <RelativeLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:background="?attr/selectableItemBackground"
                                android:clickable="true"
                                android:id="@+id/reset_dir_tree_lay">
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/reset_dir_tree"
                                    android:textColor="@color/txt"
                                    android:layout_margin="10dp"
                                    android:id="@+id/build_latex"
                                    android:background="@android:color/transparent"
                                    android:layout_centerVertical="true"/>

                            </RelativeLayout>
                            <com.google.android.material.divider.MaterialDivider
                                android:layout_width="match_parent"
                                android:layout_height="1dp"/>
                            <com.google.android.material.divider.MaterialDivider
                                android:layout_width="match_parent"
                                android:layout_height="1dp"/>
                            <RelativeLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:background="?attr/selectableItemBackground"
                                android:clickable="true"
                                android:id="@+id/show_version_lay">
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/show_version"
                                    android:textColor="@color/txt"
                                    android:layout_margin="10dp"
                                    android:id="@+id/test_latex"
                                    android:background="@android:color/transparent"
                                    android:layout_centerVertical="true"/>

                            </RelativeLayout>
                            <com.google.android.material.divider.MaterialDivider
                                android:layout_width="match_parent"
                                android:layout_height="1dp"/>

                            <RelativeLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:background="?attr/selectableItemBackground"
                                android:clickable="true"
                                android:id="@+id/show_xetex_version_lay">
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/xetex_version"
                                    android:textColor="@color/txt"
                                    android:layout_margin="10dp"
                                    android:id="@+id/xetex_version"
                                    android:background="@android:color/transparent"
                                    android:layout_centerVertical="true"/>

                            </RelativeLayout>
                            <com.google.android.material.divider.MaterialDivider
                                android:layout_width="match_parent"
                                android:layout_height="1dp"/>
                            <com.google.android.material.divider.MaterialDivider
                                android:layout_width="match_parent"
                                android:layout_height="1dp"/>
                            <RelativeLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_margin="5dp"
                                android:background="@android:color/transparent">
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/compiler"
                                    android:textColor="@color/txt"
                                    android:id="@+id/compiler_txt"
                                    android:background="@android:color/transparent"
                                    android:layout_centerVertical="true"/>
                                <include layout="@layout/compiler_chooser"
                                    android:layout_width="150dp"
                                    android:layout_height="wrap_content"
                                    android:layout_centerInParent="true"
                                    />
                            </RelativeLayout>
                            <com.google.android.material.divider.MaterialDivider
                                android:layout_width="match_parent"
                                android:layout_height="1dp"/>
                            <RelativeLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:clickable="true"
                                android:id="@+id/add_a_package_rely"
                                android:background="?attr/selectableItemBackground">
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/add_a_package"
                                    android:textColor="@color/txt"
                                    android:layout_margin="10dp"
                                    android:id="@+id/add_a_package"
                                    android:background="@android:color/transparent"
                                    android:layout_centerVertical="true"/>
                            </RelativeLayout>
                            <com.google.android.material.divider.MaterialDivider
                                android:layout_width="match_parent"
                                android:layout_height="1dp"/>
                            <RelativeLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:clickable="true"
                                android:id="@+id/add_a_font_rely"
                                android:background="?attr/selectableItemBackground">
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/add_a_font"
                                    android:textColor="@color/txt"
                                    android:layout_margin="10dp"
                                    android:id="@+id/add_a_font"
                                    android:background="@android:color/transparent"
                                    android:layout_centerVertical="true"/>
                            </RelativeLayout>
                            <com.google.android.material.divider.MaterialDivider
                                android:layout_width="match_parent"
                                android:layout_height="1dp"/>
                            <RelativeLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:clickable="true"
                                android:id="@+id/kpathsea_depug_rely"
                                android:background="?attr/selectableItemBackground">
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/run_with_kpathsea_depug"
                                    android:textColor="@color/txt"
                                    android:layout_margin="10dp"
                                    android:id="@+id/kpathsea_depug"
                                    android:background="@android:color/transparent"
                                    android:layout_centerVertical="true"/>
                                <com.google.android.material.switchmaterial.SwitchMaterial
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_alignParentEnd="true"
                                    android:layout_centerVertical="true"
                                    android:id="@+id/kpathsea_depug_switch"
                                    android:layout_margin="10dp"/>
                            </RelativeLayout>
                            <com.google.android.material.divider.MaterialDivider
                                android:layout_width="match_parent"
                                android:layout_height="1dp"/>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                    <!--                app settings-->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/app_settings"
                        android:textColor="@color/ex_item"
                        android:layout_marginStart="18dp"/>
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_margin="8dp"
                        android:backgroundTint="#343434">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:background="@android:color/transparent">
                            <RelativeLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_margin="5dp"
                                android:background="@android:color/transparent">
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/themes"
                                    android:textColor="@color/txt"
                                    android:id="@+id/themes"
                                    android:background="@android:color/transparent"
                                    android:layout_centerVertical="true"/>
                                <include android:layout_width="150dp"
                                    android:layout_height="wrap_content"
                                    android:layout_centerInParent="true"
                                    layout="@layout/theme_chooser"/>
                            </RelativeLayout>
                            <com.google.android.material.divider.MaterialDivider
                                android:layout_width="match_parent"
                                android:layout_height="1dp"/>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>

            </RelativeLayout>
        </androidx.core.widget.NestedScrollView>
    </androidx.coordinatorlayout.widget.CoordinatorLayout>
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_centerInParent="true"
        android:background="@color/loading_bkg"
        android:id="@+id/loading_lay"
        android:visibility="gone">
        <com.google.android.material.loadingindicator.LoadingIndicator
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:fitsSystemWindows="true"
            android:backgroundTint="@android:color/transparent"
            android:id="@+id/loading"
            android:visibility="visible"
            />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="hello"
            android:layout_below="@id/loading"
            android:layout_centerHorizontal="true"
            android:id="@+id/state_text"
            android:visibility="visible"
            />
        </RelativeLayout>
</RelativeLayout>